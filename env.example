# OpenClaw CLI Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env file to version control!

# OpenClaw Configuration (optional)
# These are only needed if you want to use OpenClaw integration features
# OPENCLAW_CONFIG_PATH=~/.openclaw/config.json
# OPENCLAW_STATE_DIR=~/.openclaw/state

# Model Configuration (optional)
# DEFAULT_MODEL=qwen-plus
# MODEL_API_KEY=your_api_key_here

# Feishu Configuration (optional - for Feishu integration)
# FEISHU_APP_ID=your_app_id
# FEISHU_APP_SECRET=your_app_secret
# FEISHU_BOT_TOKEN=your_bot_token

# Email Configuration (optional - for email notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_password

# General Settings
# VERBOSE=true
# DEBUG=false
# TIMEOUT=300
